{
  "name": "lrda_website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm clear-ports && pnpm api:docker:up && pnpm api:db:push && concurrently -k -n api,web,docs -c blue,cyan,magenta \"pnpm dev:api\" \"sleep 2 && pnpm --filter web dev\" \"pnpm dev:docs\"",
    "dev:api": "pnpm --filter @lrda/api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:docs": "pnpm --filter @lrda/docs dev",
    "docs:build": "pnpm --filter @lrda/docs build",
    "docs:preview": "pnpm --filter @lrda/docs preview",
    "api:db:generate": "pnpm --filter @lrda/api db:generate",
    "api:db:migrate": "pnpm --filter @lrda/api db:migrate",
    "api:db:push": "pnpm --filter @lrda/api db:push",
    "api:db:studio": "pnpm --filter @lrda/api db:studio",
    "api:db:seed": "pnpm --filter @lrda/api db:seed",
    "api:docker:up": "pnpm --filter @lrda/api docker:up",
    "api:docker:down": "pnpm --filter @lrda/api docker:down-v",
    "clear-ports": "lsof -ti:3000 -ti:3001 -ti:3002 2>/dev/null | xargs kill -9 2>/dev/null || true",
    "deploy:web": "pnpm --filter web run deploy",
    "deploy:docs": "pnpm --filter @lrda/docs run deploy",
    "typecheck": "pnpm --filter @lrda/api typecheck && pnpm --filter web typecheck",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "pnpm --filter web test",
    "test:unit": "pnpm --filter web test:unit",
    "test:integration": "pnpm --filter web test:integration",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:headed": "pnpm --filter web test:e2e:headed",
    "test:e2e:install": "pnpm --filter web test:e2e:install",
    "knip": "knip",
    "setup": "cp packages/web/.env.example packages/web/.env.local && cp packages/api/.env.example packages/api/.env && echo 'Created .env files - ready for pnpm dev'"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/eslint-plugin-router": "^1.161.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "knip": "^6.14.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4"
  }
}
