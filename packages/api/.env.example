# Server
ENVIRONMENT=development
PORT=3002
DATABASE_URL=postgresql://lrda:lrda_dev@localhost:5433/lrda_api

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3002
WEB_URL=http://localhost:3000

# CORS (comma-separated origins for production)
# CORS_ORIGINS=https://your-domain.com

# Cookie domain for cross-subdomain auth (e.g. web on example.com, API on api.example.com)
# COOKIE_DOMAIN=.your-domain.com

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@wheresreligion.org

# Google Maps (for reverse geocoding)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# RERUM API (for sync scripts during migration)
RERUM_API_URL=https://lived-religion-dev.rerum.io/deer-lr/

# Firebase Admin SDK (for user sync during migration)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# OpenRouter AI (for tag generation)
# Get your API key from https://openrouter.ai/keys
# Comma-separated list of models -- OpenRouter tries them in order as fallbacks
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODELS=google/gemini-2.0-flash-001,openai/gpt-4o-mini
