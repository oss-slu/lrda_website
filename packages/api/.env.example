NODE_ENV=development
PORT=3002
DATABASE_URL=postgresql://lrda:lrda_dev@localhost:5433/lrda_api
LOG_LEVEL=debug

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3002

# CORS (comma-separated list of allowed origins for production)
# CORS_ORIGINS=https://wheresreligion.org,https://www.wheresreligion.org

# RERUM API (for sync during migration)
# Required for RERUM sync scripts to work
RERUM_API_URL=https://lived-religion-dev.rerum.io/deer-lr/

# Firebase Admin SDK (for user sync during migration)
# Get from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Option 1: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option 2: Service account JSON as string (for CI/CD)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Web app URL (used to build links in emails)
WEB_URL=http://localhost:3000

# Email (Resend) -- only needed in production; dev mode logs to console
RESEND_API_KEY=your-resend-api-key-change-in-production
EMAIL_FROM=noreply@wheresreligion.org