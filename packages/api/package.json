{
  "name": "@lrda/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch-path src src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx src/scripts/seed.ts --yolo",
    "docker:up": "docker compose up -d --wait",
    "docker:down-v": "docker compose down -v",
    "promote-admin": "node --import tsx src/scripts/promote-admin.ts"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.12",
    "@hono/node-server": "^2.0.4",
    "@hono/zod-openapi": "^1.4.0",
    "@lrda/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.19",
    "better-auth": "^1.6.12",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "pg": "^8.21.0",
    "resend": "^6.12.4",
    "tsx": "^4.22.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "firebase-admin": "^13.7.0"
  }
}
