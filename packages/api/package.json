{
  "name": "@lrda/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch-path src src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx src/scripts/seed.ts --yolo",
    "docker:up": "docker compose up -d --wait",
    "docker:down-v": "docker compose down -v",
    "promote-admin": "node --import tsx src/scripts/promote-admin.ts",
    "sync:users": "node --import tsx src/scripts/sync-users-from-firebase.ts",
    "sync:users:yolo": "node --import tsx src/scripts/sync-users-from-firebase.ts --yolo",
    "sync:from-rerum": "node --import tsx src/scripts/sync-from-rerum.ts",
    "sync:from-rerum:yolo": "node --import tsx src/scripts/sync-from-rerum.ts --yolo",
    "sync:to-rerum": "node --import tsx src/scripts/sync-to-rerum.ts",
    "sync:to-rerum:yolo": "node --import tsx src/scripts/sync-to-rerum.ts --yolo"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/zod-openapi": "^0.18.4",
    "@lrda/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.5.175",
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.4",
    "pg": "^8.15.6",
    "resend": "^6.9.3",
    "tsx": "^4.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "@types/pg": "^8.11.14",

    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "optionalDependencies": {
    "firebase-admin": "^13.6.0"
  }
}
