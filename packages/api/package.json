{
  "name": "@lrda/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply lrda-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lrda-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/scripts/seed.ts --yolo",
    "types": "wrangler types",
    "sync:from-rerum": "bun run src/scripts/sync-from-rerum.ts",
    "sync:from-rerum:yolo": "bun run src/scripts/sync-from-rerum.ts --yolo",
    "sync:to-rerum": "bun run src/scripts/sync-to-rerum.ts",
    "sync:to-rerum:yolo": "bun run src/scripts/sync-to-rerum.ts --yolo",
    "sync:users": "bun run src/scripts/sync-users-from-firebase.ts",
    "sync:users:yolo": "bun run src/scripts/sync-users-from-firebase.ts --yolo"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.4",
    "@lrda/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.5.175",
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.4",
    "resend": "^6.9.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250312.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.0.0"
  },
  "optionalDependencies": {
    "firebase-admin": "^13.6.0"
  }
}
