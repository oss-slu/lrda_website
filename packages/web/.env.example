# =============================================================================
# Where's Religion? - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# Run: cp .env.example .env.local
#
# NOTE: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put secrets in NEXT_PUBLIC_ variables.
# =============================================================================

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------
# URL of the backend API server (Hono on Node.js)
# For local development, the API runs on port 3002
#
NEXT_PUBLIC_API_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# Google Maps API (Optional - for map features)
# -----------------------------------------------------------------------------
# Only needed if working on map-related features
# Get your API key from https://console.cloud.google.com/google/maps-apis
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
